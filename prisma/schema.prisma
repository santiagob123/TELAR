generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?
  createdAt DateTime @default(now())
  businesses Business[]
}

model Business {
  id           String          @id @default(cuid())
  name         String
  description  String?
  contactPhone String?
  whatsapp     String?
  email        String?
  address      String?
  openingHours String?
  website      String?
  instagram    String?
  facebook     String?
  linkedin     String?
  createdAt    DateTime        @default(now())
  ownerId      String?
  owner        User?           @relation(fields: [ownerId], references: [id])
  profile      DigitalProfile?
  knowledge    KnowledgeBase[]
  conversations Conversation[]
  classifications EmailClassification[]

  @@index([ownerId])
}

model DigitalProfile {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  businessId  String   @unique
  business    Business @relation(fields: [businessId], references: [id])
  tags        Tag[]
}

model Tag {
  id           String @id @default(cuid())
  identifier   String @unique
  status       String @default("active")
  profileId    String?
  profile      DigitalProfile? @relation(fields: [profileId], references: [id])
}

model KnowledgeBase {
  id         String   @id @default(cuid())
  title      String
  content    String
  isEditable Boolean  @default(false)
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
}

model Conversation {
  id         String   @id @default(cuid())
  businessId String
  from       String
  state      String   @default("open")
  messages   Message[]
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  from           String
  text           String
  isFromAI       Boolean  @default(false)
  createdAt      DateTime @default(now())
  idempotencyKey String?  @unique
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId, createdAt])
}

model RateLimitBucket {
  id        String   @id @default(cuid())
  key       String
  window    DateTime @db.Timestamptz(3)
  count     Int      @default(0)
  expiresAt DateTime @db.Timestamptz(3)

  @@unique([key, window], name: "key_window")
  @@index([expiresAt])
}

model EmailClassification {
  id              String   @id @default(cuid())
  businessId      String
  externalId      String?
  categoria       String
  prioridad       String
  resumen         String
  requiereAccion  Boolean
  accionSugerida  String
  createdAt       DateTime @default(now())
  business        Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, externalId])
  @@index([businessId, createdAt])
}

model N8nIdempotency {
  id          String   @id @default(cuid())
  key         String   @unique
  payloadHash String
  status      String   @default("pending")
  response    Json?
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
}
