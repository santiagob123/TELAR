# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# TELAR TAG — protección del panel administrativo de TAG
# Genera un valor secreto con: openssl rand -hex 32
ADMIN_TOKEN=

# TELAR AI — protección del panel administrativo de TELAR AI
# Independiente de ADMIN_TOKEN: cada MVP tiene su propia credencial
# Genera un valor secreto con: openssl rand -hex 32
AI_TOKEN=

# AI provider: ollama, openai or fallback
AI_PROVIDER=ollama

# Ollama local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# WhatsApp
WHATSAPP_MODE=demo
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
