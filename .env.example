# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
# Prisma direct connection for migrations and commands that require a direct DB connection.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Sesiones de usuario (requerido para login por correo y contraseña)
# Genera con: openssl rand -hex 32
SESSION_SECRET=

# Rate limits (positive integer overrides; defaults shown)
RATE_LIMIT_PUBLIC_IP_PER_MIN=10
RATE_LIMIT_PUBLIC_SESSION_PER_HOUR=60
RATE_LIMIT_AI_OWNER_PER_MIN=10
RATE_LIMIT_AI_OWNER_PER_HOUR=60
RATE_LIMIT_N8N_PER_MIN=120
# Comma-separated IPs of trusted reverse proxies; leave empty when there is no proxy.
RATE_LIMIT_TRUSTED_PROXIES=

# TELAR TAG — protección del panel administrativo de TAG
# Genera un valor secreto con: openssl rand -hex 32
ADMIN_TOKEN=
# User.id que representa al principal autenticado por ADMIN_TOKEN
ADMIN_USER_ID=

# TELAR AI — protección del panel administrativo de TELAR AI
# Independiente de ADMIN_TOKEN: cada MVP tiene su propia credencial
# Genera un valor secreto con: openssl rand -hex 32
AI_TOKEN=
# User.id que representa al principal autenticado por AI_TOKEN
AI_USER_ID=

# Integración privada con n8n
N8N_WEBHOOK_SECRET=

# AI provider: ollama, openai or fallback
AI_PROVIDER=ollama

# Ollama local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT_MS=60000

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# WhatsApp — el flujo previsto usa n8n; guardar las credenciales de Cloud API en n8n Credentials.
# La aplicación aún no consume un token de WhatsApp directamente.
WHATSAPP_MODE=demo
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=

# WhatsApp Cloud API: Meta callback into TELAR and protected forwarding to n8n.
# Configure only in the runtime environment where TELAR runs (for example Vercel Production).
META_APP_SECRET=
# Uses WHATSAPP_VERIFY_TOKEN above as a compatibility fallback when unset.
META_WHATSAPP_VERIFY_TOKEN=
N8N_WHATSAPP_WEBHOOK_URL=
# Generate a random secret of at least 32 characters and store the same value
# in Vercel and in the Header Auth credential of the n8n POST webhook.
N8N_WHATSAPP_FORWARD_SECRET=
